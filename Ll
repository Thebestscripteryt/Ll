-- ✅ Load Wizard UI Library
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/bloodball/-back-ups-for-libs/main/wizard"))()

-- Create main window
local Window = Library:NewWindow("Thebestscripter")
local Section = Window:NewSection("Main Features")

-- Player reference
local player = game.Players.LocalPlayer

-- Teleport function
local function tpTo(part)
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    end
end

-- Stop control
local activeThread = nil
local function stopAll()
    if activeThread then
        task.cancel(activeThread)
        activeThread = nil
    end
end

-- 🟢 BUTTON 1: Ducks in workspace.Ducks → Mansion
Section:CreateButton("Ducks → Mansion (Once)", function()
    stopAll()
    activeThread = task.spawn(function()
        for group = 1, 4 do
            local maxNum = (group == 4) and 4 or 5
            for num = 1, maxNum do
                local duck = workspace:FindFirstChild("Ducks") and workspace.Ducks:FindFirstChild("duck" .. group .. "." .. num)
                if duck then
                    tpTo(duck)
                    task.wait(1)
                end
            end
        end
        local mansion = workspace:FindFirstChild("Mansion")
            and workspace.Mansion:FindFirstChild("Activ")
            and workspace.Mansion.Activ:FindFirstChild("TeleportPartMain")
        if mansion then
            tpTo(mansion)
        end
    end)
end)

