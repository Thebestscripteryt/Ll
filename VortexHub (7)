                        open = false
                        frame.Size = UDim2.new(1, 0, 0, 44)
                    end
                end
            end))
            refresh(false)
            local control = {Object = frame, Get = function() return selected end, GetArray = function()
                local values = {}
                for _, option in ipairs(options) do if selected[option] then table.insert(values, option) end end
